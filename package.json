{
  "name": "selkies-client",
  "version": "0.1.0",
  "description": "Fullscreen Selkies client with keyboard capture",
  "author": "Paul Salamé",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.selkies.client",
    "productName": "Selkies Client",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "signtoolOptions": {
        "publisherName": "Selkies Client"
      }
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${os}.${ext}"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  }
}
