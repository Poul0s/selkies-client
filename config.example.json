{
  "default": "maison",
  "shortcuts": {
    "toggleCapture": "Ctrl+Alt+Shift+Z",
    "reload": "Ctrl+Alt+Shift+R",
    "quit": "Ctrl+Alt+Shift+Q"
  },
  "autoCapture": true,
  "recaptureOnFocus": false,
  "hooks": {
    "onCapture": [["i3-msg", "mode", "passthrough"]],
    "onRelease": [["i3-msg", "mode", "default"]]
  },
  "profiles": {
    "maison": {
      "host": "100.67.167.33:18080",
      "user": "me",
      "passwordFile": "~/.config/selkies-client/maison.pass",
      "certFingerprint": "sha256/REPLACE_WITH_THE_FINGERPRINT"
    },
    "funnel": {
      "host": "machine.tailnet.ts.net",
      "user": "me",
      "passwordEnv": "SELKIES_FUNNEL_PW",
      "hooks": { "onCapture": [], "onRelease": [] }
    }
  }
}
